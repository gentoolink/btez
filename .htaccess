# EZE-SET — force HTTPS, and settle on the apex host.
# Apache/LiteSpeed with mod_rewrite, as shipped on cPanel.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host is the apex, ezeset.ca — that is what the sheet and the
  # disclaimer print. Send www there, straight to HTTPS, so http://www
  # resolves in a single redirect rather than two.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Everything else: redirect to HTTPS unless the request is already secure.
  # The second condition covers cPanel setups that terminate TLS at a proxy,
  # where %{HTTPS} reads as off on the back end.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>
